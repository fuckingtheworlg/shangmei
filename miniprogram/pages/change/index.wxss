.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  color: #888; font-size: 30rpx;
}
.tab.active {
  color: #1890ff; font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}
.log-card, .msg-card { padding: 24rpx; }
.qty { font-size: 32rpx; font-weight: 600; }
.qty.green { color: #52c41a; }
.qty.red { color: #f5222d; }
.picker-wrap { padding: 18rpx 24rpx; }
