<view class="container">
  <view class="tab-bar">
    <view class="tab {{tab === 'change' ? 'active' : ''}}" bindtap="switchTab" data-tab="change">设备变动</view>
    <view class="tab {{tab === 'message' ? 'active' : ''}}" bindtap="switchTab" data-tab="message">跨厂消息</view>
    <view class="tab {{tab === 'request' ? 'active' : ''}}" bindtap="switchTab" data-tab="request">
      调动申请<text wx:if="{{pendingBadge}}" class="badge">{{pendingBadge}}</text>
    </view>
  </view>

  <block wx:if="{{tab === 'change'}}">
    <view wx:if="{{isCenter}}" class="card picker-wrap" style="margin:20rpx;">
      <picker bindchange="onFactoryChange" range="{{factories}}" range-key="name" value="{{factoryIndex}}">
        <view class="row" style="justify-content:space-between;">
          <text class="muted">查看工厂</text>
          <text>{{currentFactory.name || '全部'}} ›</text>
        </view>
      </picker>
    </view>

    <view wx:if="{{!logs.length}}" class="empty">暂无变动</view>
    <view wx:for="{{logs}}" wx:key="id" class="card log-card">
      <view class="row" style="justify-content:space-between;">
        <view class="flex-1">
          <view>
            <text class="tag {{item.action === 'TRANSFER_IN' ? 'tag-green' : item.action === 'TRANSFER_OUT' ? 'tag-orange' : item.action === 'IMPORT' ? 'tag-blue' : item.action === 'DELETE' ? 'tag-red' : 'tag-blue'}}">{{item.actionText}}</text>
            <text style="margin-left:10rpx; font-weight:500;">{{item.targetName}}</text>
          </view>
          <view class="muted" style="margin-top:6rpx;">
            <text wx:if="{{isCenter}}">{{item.factoryName}} · </text>
            {{item.userName}} · {{item.timeText}}
          </view>
          <view wx:if="{{item.remark}}" class="muted" style="margin-top:4rpx;">备注：{{item.remark}}</view>
        </view>
        <view style="text-align:right;">
          <view class="muted">{{item.beforeQty}} → {{item.afterQty}}</view>
          <view class="qty {{item.delta > 0 ? 'green' : item.delta < 0 ? 'red' : ''}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'message'}}">
    <view wx:if="{{!messages.length}}" class="empty">暂无消息</view>
    <view wx:for="{{messages}}" wx:key="id" class="card msg-card">
      <view style="font-weight:500;">
        <text class="tag tag-blue">跨厂调动</text>
        {{' '}}{{item.targetName}}
      </view>
      <view class="muted" style="margin-top:8rpx;">
        {{item.fromFactoryName}} <text style="color:#1890ff;">→</text> {{item.toFactoryName}}
        ·  数量 {{item.quantity}}
      </view>
      <view class="muted" style="margin-top:4rpx;">操作人：{{item.operatorName}} · {{item.timeText}}</view>
      <view wx:if="{{item.remark}}" class="muted" style="margin-top:4rpx;">备注：{{item.remark}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="card" style="margin:20rpx;" bindtap="goRequestPage">
      <view class="row" style="justify-content:space-between;">
        <view>
          <view style="font-weight:600;">查看完整调动申请列表</view>
          <view class="muted small">含待审批 / 已通过 / 已拒绝 / 已取消</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
    <view wx:if="{{!requests.length}}" class="empty">暂无申请</view>
    <view wx:for="{{requests}}" wx:key="id" class="card req-card">
      <view class="row" style="justify-content:space-between;">
        <view class="from-to">
          <text class="fac">{{item.fromFactoryName}}</text>
          <text class="arrow"> → </text>
          <text class="fac">{{item.toFactoryName}}</text>
        </view>
        <view class="status status-{{item.status}}">{{statusText[item.status]}}</view>
      </view>
      <view class="muted" style="margin-top:8rpx;">
        {{item.targetType === 'DEVICE' ? '设备' : '配件'}} · {{item.targetName}} · {{item.quantity}}
      </view>
      <view class="muted small" style="margin-top:4rpx;">
        {{item.applicantName}} · {{item.timeText}}
      </view>
    </view>
  </block>
</view>
