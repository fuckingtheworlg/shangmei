.page { padding-bottom: 40rpx; background: #f4f6f8; min-height: 100vh; }

/* Hero */
.hero {
  position: relative;
  padding: 40rpx 30rpx 120rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1890ff 0%, #4dabff 60%, #69c0ff 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(24,144,255,0.25);
}
.hero-content { position: relative; z-index: 1; color: #fff; }

.hero-greet {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 40rpx;
}
.greet-hello { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; }
.greet-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }
.hero-clock { text-align: right; }
.clock-time { font-size: 42rpx; font-weight: 600; font-family: 'DIN', sans-serif; }
.clock-date { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

.top-row { display: flex; gap: 20rpx; }
.top-card {
  flex: 1;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}
.top-card::before {
  content: '';
  position: absolute; top: -20rpx; right: -20rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(255,255,255,0.1);
}
.top-num { font-size: 56rpx; font-weight: 700; line-height: 1; margin-bottom: 8rpx; font-family: 'DIN', sans-serif; }
.top-num.red { color: #fff1f0; text-shadow: 0 2rpx 8rpx rgba(245,34,45,0.4); }
.top-num.green { color: #f6ffed; text-shadow: 0 2rpx 8rpx rgba(82,196,26,0.4); }
.top-title { font-size: 28rpx; font-weight: 500; }
.top-desc { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }

/* 数据胶囊 */
.capsule-row {
  display: flex; gap: 16rpx;
  margin: -80rpx 24rpx 24rpx;
  position: relative; z-index: 2;
}
.capsule {
  flex: 1;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.cap-blue   { background: linear-gradient(135deg, #1890ff, #4dabff); }
.cap-green  { background: linear-gradient(135deg, #52c41a, #95de64); }
.cap-orange { background: linear-gradient(135deg, #fa8c16, #ffc069); }
.cap-label { font-size: 22rpx; opacity: 0.92; }
.cap-value { font-size: 42rpx; font-weight: 700; margin-top: 6rpx; font-family: 'DIN', sans-serif; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1f2d3d; }
.card-sub { font-size: 24rpx; color: #1890ff; font-weight: 600; }

/* 状态分布条 */
.status-bar {
  height: 24rpx; border-radius: 12rpx; overflow: hidden;
  background: #f0f0f0; display: flex; margin-bottom: 24rpx;
}
.seg { height: 100%; transition: width 0.4s; }
.seg.in-use   { background: #1890ff; }
.seg.standby  { background: #52c41a; }
.seg.idle     { background: #fa8c16; }
.seg.stopped  { background: #722ed1; }

.status-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  row-gap: 16rpx; column-gap: 20rpx;
}
.st-item { display: flex; align-items: center; gap: 12rpx; }
.st-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; }
.st-dot.in-use   { background: #1890ff; }
.st-dot.standby  { background: #52c41a; }
.st-dot.idle     { background: #fa8c16; }
.st-dot.stopped  { background: #722ed1; }
.st-text { color: #666; font-size: 26rpx; }
.st-val { color: #1f2d3d; font-weight: 600; margin-left: 6rpx; }

/* 快捷操作 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.quick-item { text-align: center; }
.quick-icon {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  margin: 0 auto 10rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 36rpx; font-weight: 600;
}
.q-blue   { background: linear-gradient(135deg, #1890ff, #4dabff); }
.q-green  { background: linear-gradient(135deg, #52c41a, #95de64); }
.q-orange { background: linear-gradient(135deg, #fa8c16, #ffc069); }
.q-purple { background: linear-gradient(135deg, #722ed1, #b37feb); }
.quick-label { font-size: 24rpx; color: #555; }

.empty { text-align: center; color: #b0b8c1; padding: 40rpx 0; font-size: 26rpx; }
