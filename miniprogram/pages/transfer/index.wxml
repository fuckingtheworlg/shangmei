<view class="container">
  <view class="info-card">
    <view class="info-title">提交跨厂调动申请</view>
    <view class="info-sub">提交后由彬渭中心审批，通过后自动调拨</view>
  </view>

  <view class="card">
    <view class="form-row">
      <text class="label">调出工厂</text>
      <picker bindchange="onFromChange" range="{{fromFactories}}" range-key="name" value="{{fromIndex}}" disabled="{{!isCenter}}">
        <view class="value">{{fromFactories[fromIndex].name || '请选择'}} {{isCenter ? '›' : ''}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">调入工厂</text>
      <picker bindchange="onToChange" range="{{factories}}" range-key="name" value="{{toIndex}}">
        <view class="value">{{factories[toIndex].name || '请选择'}} ›</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">类型</text>
      <view class="type-tabs">
        <view class="type-tab {{type === 'DEVICE' ? 'active' : ''}}" bindtap="switchType" data-type="DEVICE">设备</view>
        <view class="type-tab {{type === 'PART' ? 'active' : ''}}" bindtap="switchType" data-type="PART">配件</view>
      </view>
    </view>
    <view class="form-row">
      <text class="label">型号</text>
      <picker bindchange="onTargetChange" range="{{targets}}" range-key="label" value="{{targetIndex}}">
        <view class="value">{{targets[targetIndex].label || '请选择'}} ›</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">数量</text>
      <input class="value" type="digit" placeholder="请输入" value="{{quantity}}" bindinput="onQty" />
    </view>
    <view class="form-row">
      <text class="label">申请说明</text>
      <input class="value" placeholder="可选" value="{{remark}}" bindinput="onRemark" />
    </view>
    <button class="btn-primary" style="margin-top:30rpx;" bindtap="submit" loading="{{loading}}">提交申请</button>
  </view>

  <view class="card" bindtap="goList">
    <view class="row" style="justify-content:space-between;">
      <text>查看我的调动申请</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
