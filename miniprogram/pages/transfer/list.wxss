.container { padding-bottom: 40rpx; }
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  color: #888; font-size: 28rpx;
}
.tab.active {
  color: #1890ff; font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}
.req-card { padding: 24rpx; }
.from-to { font-size: 28rpx; }
.fac { font-weight: 600; }
.arrow { color: #1890ff; font-weight: 600; }
.status {
  padding: 4rpx 14rpx; border-radius: 16rpx;
  font-size: 22rpx; font-weight: 600;
}
.status-PENDING   { background: #fff7e6; color: #fa8c16; }
.status-COMPLETED { background: #f6ffed; color: #52c41a; }
.status-APPROVED  { background: #e6f7ff; color: #1890ff; }
.status-REJECTED  { background: #fff1f0; color: #f5222d; }
.status-CANCELLED { background: #fafafa; color: #999; }
.small { font-size: 22rpx; }

.actions {
  margin-top: 18rpx;
  display: flex; gap: 16rpx; justify-content: flex-end;
}
.btn-approve, .btn-reject {
  padding: 12rpx 36rpx; line-height: 1;
  border-radius: 10rpx; font-size: 26rpx;
}
.btn-approve::after, .btn-reject::after { border: none; }
.btn-approve { background: #1890ff; color: #fff; }
.btn-reject { background: #fff; color: #f5222d; border: 1rpx solid #ffccc7; }
