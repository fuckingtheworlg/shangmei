.form-row {
  display: flex; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child { border-bottom: none; }
.label { width: 160rpx; color: #555; }
.value { flex: 1; color: #2c3e50; text-align: right; }

.type-tabs { display: flex; gap: 16rpx; flex: 1; justify-content: flex-end; }
.type-tab {
  padding: 8rpx 28rpx; border-radius: 24rpx;
  background: #f0f2f5; color: #666; font-size: 26rpx;
}
.type-tab.active { background: #1890ff; color: #fff; }
