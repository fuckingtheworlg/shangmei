.container { padding-bottom: 40rpx; }
.head { padding: 24rpx; }
.dev-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.total { color: #1890ff; font-weight: 700; font-size: 28rpx; }

.b-row {
  display: flex; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.b-row:last-child { border-bottom: none; }
.b-tag {
  display: inline-block;
  padding: 8rpx 24rpx; border-radius: 16rpx;
  font-size: 26rpx; font-weight: 600;
  width: 100rpx; text-align: center;
}
.b-tag.in-use   { background:#e6f7ff; color:#1890ff; }
.b-tag.standby  { background:#f6ffed; color:#52c41a; }
.b-tag.idle     { background:#fff7e6; color:#fa8c16; }
.b-tag.stopped  { background:#f9f0ff; color:#722ed1; }

.b-actions { flex: 1; display: flex; align-items: center; gap: 16rpx; justify-content: flex-end; }
.b-btn {
  width: 60rpx; height: 60rpx; line-height: 60rpx;
  border-radius: 50%; background: #f5f5f5;
  font-size: 32rpx; padding: 0;
}
.b-btn::after { border: none; }
.b-input {
  width: 140rpx; text-align: center;
  height: 60rpx; line-height: 60rpx;
  border: 1rpx solid #e8e8e8; border-radius: 10rpx;
  font-size: 30rpx; font-weight: 600;
}
.remark { flex: 1; text-align: right; padding: 0 12rpx; }
