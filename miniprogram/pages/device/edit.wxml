<view class="container">
  <view class="card head">
    <view class="dev-title">{{name}} <text class="muted">{{spec}}</text></view>
    <view class="muted">合计：<text class="total">{{total}}</text></view>
  </view>

  <view class="card">
    <view class="b-row">
      <view class="b-tag in-use">在用</view>
      <view class="b-actions">
        <view class="b-btn minus" data-key="inUse" data-d="-1" bindtap="step">−</view>
        <input class="b-input" type="digit" value="{{inUse}}" bindinput="onInput" data-key="inUse" />
        <view class="b-btn plus" data-key="inUse" data-d="1" bindtap="step">+</view>
      </view>
    </view>
    <view class="b-row">
      <view class="b-tag standby">备用</view>
      <view class="b-actions">
        <view class="b-btn minus" data-key="standby" data-d="-1" bindtap="step">−</view>
        <input class="b-input" type="digit" value="{{standby}}" bindinput="onInput" data-key="standby" />
        <view class="b-btn plus" data-key="standby" data-d="1" bindtap="step">+</view>
      </view>
    </view>
    <view class="b-row">
      <view class="b-tag idle">闲置</view>
      <view class="b-actions">
        <view class="b-btn minus" data-key="idle" data-d="-1" bindtap="step">−</view>
        <input class="b-input" type="digit" value="{{idle}}" bindinput="onInput" data-key="idle" />
        <view class="b-btn plus" data-key="idle" data-d="1" bindtap="step">+</view>
      </view>
    </view>
    <view class="b-row">
      <view class="b-tag stopped">停用</view>
      <view class="b-actions">
        <view class="b-btn minus" data-key="stopped" data-d="-1" bindtap="step">−</view>
        <input class="b-input" type="digit" value="{{stopped}}" bindinput="onInput" data-key="stopped" />
        <view class="b-btn plus" data-key="stopped" data-d="1" bindtap="step">+</view>
      </view>
    </view>
    <view class="b-row remark-row">
      <view class="b-tag remark-tag">备注</view>
      <input class="remark" placeholder="可选" value="{{remark}}" bindinput="onRemark" />
    </view>
  </view>

  <button class="btn-primary" style="margin:30rpx 20rpx;" bindtap="save" loading="{{saving}}">保存</button>
</view>
