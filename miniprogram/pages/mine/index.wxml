<view class="container">
  <view class="profile-card" bindtap="goProfile">
    <image class="avatar avatar-img" src="{{avatarFull || '/images/mine.png'}}" mode="aspectFill" />

    <view class="flex-1" style="margin-left:24rpx;">
      <view class="name">{{user.name}}</view>
      <view class="sub">{{user.factoryName}} · {{roleText}}</view>
    </view>
    <view style="color:rgba(255,255,255,0.85); font-size:30rpx;">编辑 ›</view>
  </view>

  <view class="card menu" wx:if="{{isCenter}}">
    <view class="menu-title">中心管理</view>
    <view class="menu-item" bindtap="goTransfer">
      <text>跨厂调动</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNewDevice">
      <text>新建设备型号</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNewPart">
      <text>新建配件型号</text><text class="arrow">›</text>
    </view>
  </view>

  <view class="card menu" wx:elif="{{isWriter}}">
    <view class="menu-title">工厂管理</view>
    <view class="menu-item" bindtap="goNewPart">
      <text>新建配件型号</text><text class="arrow">›</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-title">系统</view>
    <view class="menu-item" bindtap="logout">
      <text style="color:#f5222d;">退出登录</text><text class="arrow">›</text>
    </view>
  </view>
</view>
