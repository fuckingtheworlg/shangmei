.profile-card {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
  margin: 20rpx;
  padding: 40rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex; align-items:center; justify-content:center;
  font-size: 44rpx; font-weight: 600;
}
.avatar-img {
  background: #fff;
}
.profile-card .name { font-size: 36rpx; font-weight: 600; }
.profile-card .sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }

.menu .menu-title { font-size: 26rpx; color: #999; padding: 12rpx 0; }
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 26rpx 0; border-top: 1rpx solid #f0f0f0;
}
.menu-item:first-of-type { border-top: none; }
.arrow { color: #ccc; }
